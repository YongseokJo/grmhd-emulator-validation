{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "schema_version": {
   "const": 1
  },
  "split_id": {
   "type": "string"
  },
  "model": {
   "type": "string"
  },
  "run_id": {
   "type": "string"
  },
  "run_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "summary_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "summary_filename": {
   "const": "summary.json"
  },
  "result_files": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
   }
  },
  "result_fingerprint": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  }
 },
 "required": [
  "schema_version",
  "split_id",
  "model",
  "run_id",
  "run_sha256",
  "summary_sha256",
  "summary_filename",
  "result_files",
  "result_fingerprint"
 ]
}
