{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "analysis": {
      "const": "rollout_evolution"
    },
    "space": {
      "enum": [
        "loss",
        "physical"
      ]
    },
    "starts": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "data": {
      "type": "object",
      "properties": {
        "per_start": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer"
              },
              "values": {
                "type": "object",
                "properties": {
                  "X": {
                    "$ref": "#/$defs/value"
                  },
                  "Y": {
                    "$ref": "#/$defs/value"
                  },
                  "samples": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "step": {
                          "$ref": "#/$defs/value"
                        },
                        "truth": {
                          "$ref": "#/$defs/value"
                        },
                        "pred": {
                          "$ref": "#/$defs/value"
                        },
                        "error": {
                          "$ref": "#/$defs/value"
                        }
                      },
                      "required": [
                        "step",
                        "truth",
                        "pred",
                        "error"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "X",
                  "Y",
                  "samples"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "start",
              "values"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "per_start"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "analysis",
    "space",
    "starts",
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    }
  }
}
