{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "analysis": {
      "const": "accretion_diagnostics"
    },
    "space": {
      "enum": [
        "loss",
        "physical"
      ]
    },
    "starts": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "data": {
      "type": "object",
      "properties": {
        "per_start": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer"
              },
              "values": {
                "type": "object",
                "properties": {
                  "flux_profiles": {
                    "$ref": "#/$defs/value"
                  },
                  "jet_power_profiles": {
                    "$ref": "#/$defs/value"
                  },
                  "phi_bh": {
                    "$ref": "#/$defs/value"
                  },
                  "mdot_pred": {
                    "type": "object",
                    "properties": {
                      "r_H": {
                        "$ref": "#/$defs/value"
                      },
                      "r10": {
                        "$ref": "#/$defs/value"
                      }
                    },
                    "required": [
                      "r_H",
                      "r10"
                    ],
                    "additionalProperties": false
                  },
                  "mdot_truth": {
                    "type": "object",
                    "properties": {
                      "r_H": {
                        "$ref": "#/$defs/value"
                      },
                      "r10": {
                        "$ref": "#/$defs/value"
                      }
                    },
                    "required": [
                      "r_H",
                      "r10"
                    ],
                    "additionalProperties": false
                  },
                  "steps": {
                    "$ref": "#/$defs/value"
                  },
                  "horizon_index": {
                    "$ref": "#/$defs/value"
                  },
                  "r10_index": {
                    "$ref": "#/$defs/value"
                  },
                  "r": {
                    "$ref": "#/$defs/value"
                  },
                  "table": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "step": {
                          "$ref": "#/$defs/value"
                        },
                        "funnel_fraction_pred": {
                          "$ref": "#/$defs/value"
                        },
                        "funnel_fraction_truth": {
                          "$ref": "#/$defs/value"
                        },
                        "jet_power_pred": {
                          "$ref": "#/$defs/value"
                        },
                        "jet_power_truth": {
                          "$ref": "#/$defs/value"
                        },
                        "efficiency_pred": {
                          "$ref": "#/$defs/value"
                        },
                        "efficiency_truth": {
                          "$ref": "#/$defs/value"
                        },
                        "jet_relative_error": {
                          "$ref": "#/$defs/value"
                        },
                        "phi_bh_relative_error": {
                          "$ref": "#/$defs/value"
                        }
                      },
                      "required": [
                        "step",
                        "funnel_fraction_pred",
                        "funnel_fraction_truth",
                        "jet_power_pred",
                        "jet_power_truth",
                        "efficiency_pred",
                        "efficiency_truth",
                        "jet_relative_error",
                        "phi_bh_relative_error"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "mdot_correlation": {
                    "type": "object",
                    "properties": {
                      "r_H": {
                        "$ref": "#/$defs/value"
                      },
                      "r10": {
                        "$ref": "#/$defs/value"
                      }
                    },
                    "required": [
                      "r_H",
                      "r10"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "flux_profiles",
                  "jet_power_profiles",
                  "phi_bh",
                  "mdot_pred",
                  "mdot_truth",
                  "steps",
                  "horizon_index",
                  "r10_index",
                  "r",
                  "table",
                  "mdot_correlation"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "start",
              "values"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "per_start"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "analysis",
    "space",
    "starts",
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    }
  }
}
