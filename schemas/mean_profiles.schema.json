{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "analysis": {
   "const": "mean_profiles"
  },
  "space": {
   "enum": [
    "loss",
    "physical"
   ]
  },
  "starts": {
   "type": "array",
   "items": {
    "type": "integer"
   },
   "minItems": 1,
   "uniqueItems": true
  },
  "data": {
   "type": "object",
   "properties": {
    "per_start": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "start": {
        "type": "integer"
       },
       "values": {
        "$ref": "#/$defs/values"
       }
      },
      "required": [
       "start",
       "values"
      ],
      "additionalProperties": false
     },
     "minItems": 1
    },
    "aggregate": {
     "type": "object",
     "properties": {
      "mean": {
       "$ref": "#/$defs/values"
      },
      "lower": {
       "$ref": "#/$defs/values"
      },
      "upper": {
       "$ref": "#/$defs/values"
      },
      "n_starts": {
       "type": "integer",
       "minimum": 1
      },
      "bootstrap": {
       "type": "object",
       "properties": {
        "method": {
         "const": "chunk_block_bootstrap"
        },
        "block_length": {
         "type": "integer",
         "minimum": 1
        },
        "n_blocks": {
         "type": "integer",
         "minimum": 1
        },
        "resamples": {
         "type": "integer",
         "minimum": 1
        },
        "seed": {
         "type": "integer"
        }
       },
       "required": [
        "method",
        "block_length",
        "n_blocks",
        "resamples",
        "seed"
       ],
       "additionalProperties": false
      },
      "valid_counts": {
       "type": "object",
       "additionalProperties": {
        "$ref": "#/$defs/value"
       }
      }
     },
     "required": [
      "mean",
      "lower",
      "upper",
      "n_starts",
      "bootstrap",
      "valid_counts"
     ],
     "additionalProperties": false
    },
    "time": {
     "type": "object",
     "properties": {
      "steps": {
       "$ref": "#/$defs/value"
      },
      "rg_c": {
       "$ref": "#/$defs/value"
      },
      "tau_c": {
       "$ref": "#/$defs/value"
      }
     },
     "required": [
      "steps",
      "rg_c",
      "tau_c"
     ],
     "additionalProperties": false
    }
   },
   "required": [
    "per_start",
    "aggregate",
    "time"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "analysis",
  "space",
  "starts",
  "data"
 ],
 "additionalProperties": false,
 "$defs": {
  "value": {
   "anyOf": [
    {
     "type": [
      "number",
      "boolean",
      "null",
      "string"
     ]
    },
    {
     "type": "array",
     "items": {
      "$ref": "#/$defs/value"
     }
    },
    {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/value"
     }
    }
   ]
  },
  "values": {
   "type": "object",
   "properties": {
    "r": {
     "$ref": "#/$defs/value"
    },
    "theta": {
     "$ref": "#/$defs/value"
    },
    "omega_pred": {
     "$ref": "#/$defs/value"
    },
    "omega_truth": {
     "$ref": "#/$defs/value"
    },
    "omega_keplerian": {
     "$ref": "#/$defs/value"
    },
    "rho_theta_pred": {
     "$ref": "#/$defs/value"
    },
    "rho_theta_truth": {
     "$ref": "#/$defs/value"
    },
    "n_steps": {
     "$ref": "#/$defs/value"
    },
    "beta_pred": {
     "$ref": "#/$defs/value"
    },
    "beta_truth": {
     "$ref": "#/$defs/value"
    },
    "sigma_pred": {
     "$ref": "#/$defs/value"
    },
    "sigma_truth": {
     "$ref": "#/$defs/value"
    }
   },
   "required": [
    "r",
    "theta",
    "omega_pred",
    "omega_truth",
    "omega_keplerian",
    "rho_theta_pred",
    "rho_theta_truth",
    "beta_pred",
    "beta_truth",
    "sigma_pred",
    "sigma_truth",
    "n_steps"
   ],
   "additionalProperties": false
  }
 }
}
