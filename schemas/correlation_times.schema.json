{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "analysis": {
      "const": "correlation_times"
    },
    "space": {
      "enum": [
        "loss",
        "physical"
      ]
    },
    "starts": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "data": {
      "type": "object",
      "properties": {
        "per_start": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer"
              },
              "values": {
                "type": "object",
                "properties": {
                  "tau_c": {
                    "$ref": "#/$defs/value"
                  },
                  "r1": {
                    "$ref": "#/$defs/value"
                  },
                  "saturated": {
                    "$ref": "#/$defs/value"
                  },
                  "n_pairs": {
                    "$ref": "#/$defs/value"
                  },
                  "n_dumps": {
                    "$ref": "#/$defs/value"
                  },
                  "n_cells": {
                    "$ref": "#/$defs/value"
                  },
                  "steps": {
                    "$ref": "#/$defs/value"
                  },
                  "skill": {
                    "$ref": "#/$defs/value"
                  },
                  "crossing_steps": {
                    "$ref": "#/$defs/value"
                  },
                  "never_crossed": {
                    "$ref": "#/$defs/value"
                  },
                  "last_positive_steps": {
                    "$ref": "#/$defs/value"
                  },
                  "fraction_positive_after_first": {
                    "$ref": "#/$defs/value"
                  },
                  "mean_skill_25_50": {
                    "$ref": "#/$defs/value"
                  },
                  "horizon_rg_c": {
                    "$ref": "#/$defs/value"
                  },
                  "horizon_tau_c": {
                    "$ref": "#/$defs/value"
                  },
                  "tau_c_rg_c": {
                    "$ref": "#/$defs/value"
                  },
                  "resolved_mask": {
                    "$ref": "#/$defs/value"
                  },
                  "starts": {
                    "$ref": "#/$defs/value"
                  }
                },
                "required": [
                  "tau_c",
                  "r1",
                  "saturated",
                  "n_pairs",
                  "n_dumps",
                  "n_cells",
                  "steps",
                  "skill",
                  "crossing_steps",
                  "never_crossed",
                  "last_positive_steps",
                  "fraction_positive_after_first",
                  "mean_skill_25_50",
                  "horizon_rg_c",
                  "horizon_tau_c",
                  "tau_c_rg_c",
                  "resolved_mask",
                  "starts"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "start",
              "values"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "per_start"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "analysis",
    "space",
    "starts",
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    }
  }
}
