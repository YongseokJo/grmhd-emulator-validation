{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "schema_version": {
   "const": 1
  },
  "evidence": {
   "const": "operator declaration"
  },
  "verified": {
   "const": false
  },
  "model": {
   "type": "string"
  },
  "version": {
   "type": "string"
  },
  "split_id": {
   "type": "string"
  },
  "split_file_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "checkpoint_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "config_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "log_sha256": {
   "anyOf": [
    {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    {
     "type": "null"
    }
   ]
  },
  "config": {
   "type": "object"
  },
  "computed": {
   "type": "object"
  }
 },
 "required": [
  "schema_version",
  "evidence",
  "verified",
  "model",
  "version",
  "split_id",
  "split_file_sha256",
  "checkpoint_sha256",
  "config_sha256",
  "log_sha256",
  "config",
  "computed"
 ]
}
