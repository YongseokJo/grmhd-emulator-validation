        },
        "n_blocks": {
         "type": "integer",
         "minimum": 1
        },
        "resamples": {
         "type": "integer",
         "minimum": 1
        },
        "seed": {
         "type": "integer"
        }
       },
       "required": [
        "method",
        "block_length",
        "n_blocks",
        "resamples",
        "seed"
       ],
       "additionalProperties": false
      },
      "valid_counts": {
       "type": "object",
